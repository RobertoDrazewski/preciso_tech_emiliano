# --- API de TTM / Preciso ---
API_BASE_URL="https://ttm.com.ar/testing/api/get_full_data.php"
# Si la API terminara pidiendo un token/apikey, agregalo acá y usalo en ApiClient.php
API_TOKEN=""
# ⚠️ MODO SIMULADOR — poné "true" mientras la API real de Emiliano esté
# caída/inestable. Genera datos con la misma estructura exacta que la API
# real (no hay que tocar más nada del código). Apenas confirme que su API
# anda de nuevo, poné esto en "false".
API_SIMULATE="false"
# ⚠️ SOLO PARA DIAGNÓSTICO LOCAL — el cert SSL de ttm.com.ar no manda la cadena
# intermedia completa (a confirmar/arreglar con Emiliano). Poner en "true" para
# saltear la verificación SSL mientras se soluciona. NUNCA dejar en true en
# producción.
API_INSECURE_SSL_TESTING="true"

# --- SMTP para alertas por email ---
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="tu-cuenta@gmail.com"
SMTP_PASS="app-password-de-16-digitos"
SMTP_FROM="tu-cuenta@gmail.com"
SMTP_FROM_NAME="Preciso - Alertas de Combustible"

# Destinatarios de las alertas, separados por coma
ALERT_EMAILS="emiliano@preciso.tech"

# --- Frontend (para CORS) ---
# De dónde va a pegarle el frontend a esta API. En local con los dos server
# corriendo aparte, dejalo en "*". En producción, poné el dominio real
# (ej: "https://preciso.tech") para no dejar la API abierta a cualquiera.
FRONTEND_ORIGIN="*"

# --- Base de datos local (SQLite) ---
DB_PATH="storage/preciso.sqlite"

# --- Zona horaria ---
APP_TIMEZONE="America/Argentina/Mendoza"

# --- Acceso al panel (v3.6) ---
# Usuario y clave para entrar al panel. Sin PANEL_CLAVE el panel queda
# abierto (sin login), como antes.
PANEL_USUARIO="emiliano"
PANEL_CLAVE=""
# Opcional: texto largo al azar para firmar las sesiones.
PANEL_SECRETO=""

# --- Notificar al cliente ---
# "true" = modo prueba: el PDF llega a NOTIFICAR_CLIENTE_EMAIL_PRUEBA (o, si
# está vacío, al primer correo de ALERT_EMAILS), nunca al cliente.
NOTIFICAR_CLIENTE_MODO_PRUEBA="true"
NOTIFICAR_CLIENTE_EMAIL_PRUEBA=""

# --- Mail de alertas del cron ---
# Un resumen cada tantas horas, solo con pérdidas de al menos tantos litros.
ALERTAS_CADA_HORAS="4"
ALERTAS_LITROS_MINIMOS="30"
