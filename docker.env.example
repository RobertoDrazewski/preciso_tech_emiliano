# Variables de docker-compose.yml. Copiar como ".env" (en esta misma carpeta,
# la raíz del repo) y completar. Las variables de la aplicación (token de TTM,
# SMTP, clave del panel, etc.) van en backend/.env, no acá.

# Clave del usuario "preciso" de la base Postgres que crea docker compose.
DB_PASSWORD=cambiar-por-una-clave-larga

# URL pública del backend, como la ve el navegador (con /api al final).
# En una sola máquina de prueba: http://localhost:8000/api
# En producción, detrás de su dominio: https://anomalias-api.su-dominio.com.ar/api
API_BASE=http://localhost:8000/api

# Puertos expuestos en la máquina.
BACKEND_PORT=8000
FRONTEND_PORT=3000

# Cada cuántos minutos corre la detección, y a qué hora (UTC-3) sale el
# resumen diario por mail.
CRON_MINUTOS=5
CRON_HORA_RESUMEN=6
